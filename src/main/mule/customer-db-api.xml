<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:db="http://www.mulesoft.org/schema/mule/db"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="get-customers-flow" doc:id="416bffc9-c9a4-4f7b-8e2f-50de7d49aac7" >
		<http:listener doc:name="Listener" doc:id="71ec26af-17da-4396-84ac-0abf4570f230" config-ref="HTTP_Listener_config" path="/customers" allowedMethods="GET">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStaus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<choice doc:name="City Filter?" doc:id="f4e532e7-a9ab-4bc3-818c-26ac3e63ae72" >
			<when expression="#[isEmpty(attributes.queryParams.city)]">
				<db:select doc:name="Select All Customers" doc:id="a535ec89-af8f-484b-8c4f-00b03a565d7c" config-ref="Database_Config">
					<db:sql ><![CDATA[SELECT
	id,
	first_name,
	last_name,
	email,
	phone,
	city
FROM customers
ORDER BY last_name, first_name]]></db:sql>
				</db:select>
			</when>
			<otherwise >
				<db:select doc:name="Select Customers by City" doc:id="35b83bb8-01bc-49bf-a6f1-43739eb353e3" config-ref="Database_Config">
					<db:sql ><![CDATA[SELECT
	id,
	first_name,
	last_name,
	email,
	phone,
	city
FROM customers
WHERE LOWER(city) = LOWER(:city)
ORDER BY last_name, first_name]]></db:sql>
					<db:input-parameters ><![CDATA[{city: attributes.queryParams}]]></db:input-parameters>
				</db:select>
			</otherwise>
		</choice>
		<ee:transform doc:name="Rows to customers" doc:id="bd589311-24ce-4c56-b6df-63b68731ddd9" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
import toCustomer from modules::CustomerMapping
output application/json
---
payload map ((row) -> toCustomer(row))]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler ref="api-error-handler" />
	</flow>
	<flow name="get-customer-by-id-flow" doc:id="f13d2707-df9e-4ff9-89ed-99dd75ab71d3" >
		<http:listener doc:name="GET /customer/{id}" doc:id="02bc39cd-6f11-4540-be45-f9a75df11204" config-ref="HTTP_Listener_config" path="/customer/{id}" allowedMethods="GET">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<set-variable value="#[attributes.uriParams.id]" doc:name="Save Customer ID" doc:id="bf923a1f-2095-4aac-82c4-3de0664a69c9" variableName="customerId"/>
		<flow-ref doc:name="Find Customer" doc:id="06a916e0-02a4-4e8e-a8bb-0932f6e1a275" name='"find-customer-flow"'/>
		<ee:transform doc:name="Row to Customer" doc:id="99dc0537-4c03-47e2-af8d-976251893eb9" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
import toCustomer from modules::CustomerMapping
output application/json
---
toCustomer(payload[0])]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler ref="api-error-handler" />
	</flow>
	<flow name="create-customer-flow" doc:id="7cc26ad6-f2f8-43e7-81b0-904447d7f038" >
		<http:listener doc:name="Listener" doc:id="2ffdaf1f-5b49-48df-bf2c-54dbfb71ec99" config-ref="HTTP_Listener_config" path="/customers" allowedMethods="POST">
			<http:response statusCode="#[vars.httpSatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<flow-ref doc:name="Validate Request" doc:id="470ed68e-f335-4000-aac6-0a8b33fd9c11" name="validate-customer-subflow"/>
		<db:select doc:name="Find by Email" doc:id="a801f15b-fdff-47fa-b979-2e82be0283dc" config-ref="Database_Config" target="exisitingCustomers">
			<db:sql ><![CDATA[SELECT id
FROM customers
WHERE email = :email]]></db:sql>
			<db:input-parameters ><![CDATA[#[{email: lower(payload.email)}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Duplicate?" doc:id="148a3024-bc19-44c5-98e8-373653e77c24" >
			<when expression="#[not isEmpty(vars.existingCustomers)]">
				<raise-error doc:name="Duplicate" doc:id="c06bdf66-a817-416a-b20c-c17e72af69a1" type="CUSTOMER:DUPLICATE" description="#['A customer with email ' ++ lower(payload.email) ++ ' already exists']"/>
			</when>
		</choice>
		<ee:transform doc:name="Build New Customer" doc:id="e6e6e529-62b6-40f0-9f59-7cea507122a0">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
}]]></ee:set-payload>
					</ee:message>
			<ee:variables >
				<ee:set-variable variableName="newCustomer" ><![CDATA[%dw 2.0
output application/java
---
{
	id: "C" ++ (uuid()[0 to 7]),
	firstName: payload.firstName,
	lastName: payload.lastName,
	email: lower(payload.email),
	phone: payload.phone default "",
	city: payload.city default ""
}]]></ee:set-variable>
			</ee:variables>
				</ee:transform>
		<db:insert doc:name="Insert Customer" doc:id="fb5b92b4-eff9-4a01-98d6-c599377a013c" config-ref="Database_Config">
			<db:sql ><![CDATA[INSERT INTO cusomters (id, first_name, last_name, email, phone, city)
VALUES (:id, :firstName, :lastName, :email, :phone, :city)]]></db:sql>
			<db:input-parameters ><![CDATA[#[vars.newCustomer]]]></db:input-parameters>
		</db:insert>
		<set-variable value="#[201]" doc:name="Status 201" doc:id="951ac863-7ad3-4f83-b64b-594551acfbad" variableName="httpStatus"/>
		<ee:transform doc:name="Respond With Customer" doc:id="12857cc8-3328-4257-94e9-e3ae1e3b2550" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
vars.newCustomer]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler ref="api-error-handler" />
	</flow>
	<flow name="update-customer-flow" doc:id="44a2977f-01c1-4358-a0f6-bb60eeeb0e10" >
		<http:listener doc:name="Listener" doc:id="2e4063d7-533b-4379-99a6-d2a843fe78e5" config-ref="HTTP_Listener_config" path="/customers/{id}" allowedMethods="PUT">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<set-variable value="#[attributes.uriParams.id]" doc:name="Save Customer ID" doc:id="9f7ca3b6-5f42-4c90-9c19-e79a247217e9" variableName="customerId"/>
		<flow-ref doc:name="Validate Request" doc:id="9adea147-d77b-41d4-95b4-db3942f6dc12" name="validate-customer-subflow"/>
		<db:select doc:name="Email Used by Another Customer?" doc:id="f0d2ad17-2c45-4823-b499-3d7663f9b7d0" config-ref="Database_Config" target="existingCustomers">
			<db:sql ><![CDATA[SELECT id
FROM customers
WHERE email = :email AND id]]></db:sql>
			<db:input-parameters ><![CDATA[#[{email: lower(payload.email), id: vars.customerId}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Duplicate?" doc:id="657b67df-4365-4f51-90fe-82d76ce44651" >
			<when expression="#[not isEmpty(vars.exisitngCustomers)]">
				<raise-error doc:name="Duplicate" doc:id="69261c8a-8cfa-4422-8cfd-81a920922c8a" type="CUSTOMER:DUPLICATE" description="#['A customer with email ' ++ lower(payload.email) ++ ' already exists']"/>
			</when>
		</choice>
		<db:update doc:name="Update Customer" doc:id="ad14e611-e823-4d15-ab3f-3a4b1c59d062" config-ref="Database_Config">
			<db:sql ><![CDATA[UPDATE customers
SET first_name = :firstName, last_name = :lastName, email = :email, phone = :phone, city = :city
WHERE id = :id]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
	id: vars.customerId,
	firstName: payload.firstName,
	lastName: payload.lastName,
	email: lower(payload.email),
	phone: payload.phone default "",
	city: payload.city default ""
}]]]></db:input-parameters>
		</db:update>
		<choice doc:name="Row Update?" doc:id="61fafc15-4929-4857-b440-ebb35fb46b74" >
			<when expression="#[payload.affectedRows == 0]">
				<raise-error doc:name="Not Found" doc:id="a18058ce-e64f-4e0e-b263-bc9d3bd7c41c" type='CUSTOMER:NOT_FOUND' description="#['Customer ' ++ vars.customerId ++ 'not found']"/>
			</when>
		</choice>
		<flow-ref doc:name="Read updated customer" doc:id="6ed012d9-aa87-4d67-82c0-485e832e6295" name="find-customer-flow"/>
		<ee:transform doc:name="Row to Customer" doc:id="7b857988-2eed-46f0-b90e-aa72a59ba0f7" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
import toCustomer from modules::CustomerMapping
output application/json
---
toCustomer(payload[0])]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler ref="api-error-handler" />
	</flow>
	<flow name="delete-customer-flow" doc:id="85a420b8-61df-4473-a6ed-18f1ce5f5a3a" >
		<http:listener doc:name="Listener" doc:id="87192e76-436d-4953-a244-ccacc5d41405" config-ref="HTTP_Listener_config" allowedMethods="GET" path="/customers/{id}">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<set-variable value="#[attributes.uriParams.id]" doc:name="Save Customer ID" doc:id="b7d8b2b3-895f-401f-be81-444b95869cff" variableName="customerId"/>
		<db:delete doc:name="Delete Customer" doc:id="84784b29-625f-4a52-a476-c9b4b2435c01" config-ref="Database_Config">
			<db:sql ><![CDATA[DELETE FROM customers
WHERE id = :id]]></db:sql>
			<db:input-parameters ><![CDATA[#[{id: vars.customerId}]]]></db:input-parameters>
		</db:delete>
		<choice doc:name="Row deleted?" doc:id="e06e4eba-816f-4f17-a073-f55ee982f40e" >
			<when expression="#[payload.affectedRows == 0]">
				<raise-error doc:name="Not Found" doc:id="961b9197-b5c8-4063-97f7-0d7d87582c90" type='"CUSTOMER:NOT_FOUND"' description="#['Customer ' ++ vars.customerId ++ 'not found']"/>
			</when>
		</choice>
		<set-variable value="#[204]" doc:name="Status 204" doc:id="54143df0-97e0-4ac6-9721-01c20efc32db" variableName="httpStatus"/>
		<set-payload value="#['']" doc:name="Empty Body" doc:id="94d04666-ea28-46ac-aa45-77715d1d122f" />
		<error-handler ref="api-error-handler" />
	</flow>
	<flow name="find-customer-flow" doc:id="dec3a54b-f8fa-4b56-854c-b4ec154ee8db" >
		<db:select doc:name="Select customer by ID" doc:id="d74d03b5-49a1-4d39-948d-fdfb03a90c90" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT id, first_name, last_name, email, phone, city
FROM customers
WHERE id = :id]]></db:sql>
			<db:input-parameters ><![CDATA[#[{id: vars.customerId}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Found?" doc:id="588b4aa4-5ba1-4ba9-b57b-df6b99e26333" >
			<when expression="#[isEmpty(payload)]">
				<raise-error doc:name="Not Found" doc:id="bfa008e8-0093-4cb7-b8db-042ea33bc64b" type='"CUSTOMER:NOT_FOUND" ' description="#['Customer ' ++ vars.customerId ++ ' not found']"/>
			</when>
		</choice>
	</flow>
	<error-handler name="api-error-handler" doc:id="45b4249a-68d2-4ff9-96a0-48ed9bbc3942" />
</mule>
